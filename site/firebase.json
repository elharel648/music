{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firebase/**", "README.md", "**/.*"],
    "cleanUrls": true,
    "headers": [
      { "source": "/latest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Access-Control-Allow-Origin", "value": "*" }] },
      { "source": "**", "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] }
    ]
  },
  "firestore": { "rules": "firebase/firestore.rules" },
  "storage": { "rules": "firebase/storage.rules" }
}
