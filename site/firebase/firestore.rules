rules_version = '2';
// Alma beta. Paste into Firebase console › Firestore Database › Rules › Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // One profile per signed-in user. They write their application; only tools/approve.py (admin) sets approved and key.
    match /profiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && !("approved" in request.resource.data) && !("key" in request.resource.data) && !("founding" in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.get("approved", false) == resource.data.get("approved", false)
                    && request.resource.data.get("key", null) == resource.data.get("key", null)
                    && request.resource.data.get("founding", null) == resource.data.get("founding", null);
      allow delete: if false;
    }

    // Which build to download. Readable by approved users only; written by tools/approve.py release.
    match /releases/{platform} {
      allow read: if request.auth != null
                  && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get("approved", false) == true;
      allow write: if false;
    }

    // Feedback from inside the app: anyone may add one (the app is not signed in), nobody reads it but the console.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(["note", "version", "email", "created", "payload"])
                    && request.resource.data.payload is string && request.resource.data.payload.size() < 900000;
      allow read, update, delete: if false;
    }
  }
}
